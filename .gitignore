# Runtime artefacts created by the portable tools
*.log
*.tmp
*.bak

# Executables (distributed via GitHub Releases)
*.exe
*.EXE

# Build artefacts and dependency caches
**/.nuget/
software/**/build/
software/**/dist/

# Tool state/config files (generated at runtime)
*_state.json
software/**/config.json

# Tool output
logs/
software/**/logs/

# Captures and exports
*.pcap
*.pcapng
*.etl
*.xlsx

# OS files
Thumbs.db
.DS_Store
